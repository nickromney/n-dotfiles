#!/usr/bin/env bash

# Exit on error
set -euo pipefail

# Default values
username="default"

usage() {
  cat <<'EOF'
Usage: aws-1password [--username default|tfcli]

Emit AWS credential_process JSON using 1Password, without writing credentials.
The default item is AWSCredsUsername<invoking-login>. Set AWS_1PASSWORD_USER
when the same 1Password account is used across different machine login names.

Examples:
  aws-1password
  aws-1password --username tfcli
  AWS_1PASSWORD_USER=my-login aws-1password
EOF
}

# Parse named parameters
while [ $# -gt 0 ]; do
  case "$1" in
  --username)
    if [[ $# -lt 2 || -z "$2" || "$2" == -* ]]; then
      echo "--username requires a profile name" >&2
      exit 1
    fi
    username="$2"
    shift 2
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *)
    echo "Unknown parameter: $1" >&2
    usage >&2
    exit 1
    ;;
  esac
done

# Map usernames to their corresponding 1Password entries
get_op_entry() {
  local primary_user
  primary_user="${AWS_1PASSWORD_USER:-$(id -un)}"

  case "$1" in
  "tfcli")
    echo "AWSCredsUsernameTFCLI"
    ;;
  "default")
    echo "AWSCredsUsername${primary_user}"
    ;;
  # Add more profiles as needed
  *)
    echo "Unknown username: $1" >&2
    exit 1
    ;;
  esac
}

readonly opVault="CLI"
opEntry=$(get_op_entry "$username")

# Fetch credentials from 1Password
accessKeyId=$(op read "op://$opVault/$opEntry/ACCESS_KEY")
secretAccessKey=$(op read "op://$opVault/$opEntry/SECRET_KEY")

# Create JSON object that AWS CLI expects
jq -n \
  --arg accessKeyId "$accessKeyId" \
  --arg secretAccessKey "$secretAccessKey" \
  ".Version = 1
    | .AccessKeyId = \$accessKeyId
    | .SecretAccessKey = \$secretAccessKey"
