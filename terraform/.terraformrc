# Terraform CLI configuration (also read by OpenTofu). Stowed from n-dotfiles/terraform.

# One shared provider cache for every working directory on this machine. Without it each
# repo and each root module downloads its own copy of every provider (azurerm alone is
# about 300 MB per directory). stow.sh creates the directory; Terraform will not.
plugin_cache_dir = "$HOME/.terraform.d/plugin-cache"

# Use the cache even when a working directory's lock file does not yet list the provider
# (for example untracked or regenerated lock files). Without this, Terraform 1.4+ skips
# the cache in that case. Trade-off: a lock file written from the cache records checksums
# for this platform only, so run `terraform providers lock -platform=...` before
# committing a lock file that other platforms must verify.
plugin_cache_may_break_dependency_lock_file = true
